// Gaia Gauntlet - Game Master dashboard.
//
// This file is only the shell: the container, the tab strip, the status bar and the confirm
// prompt. Each tab's content lives in its own GmTab*.ui and is pulled in as a @Content template.
// All five panels stay resident in the document and GmDashboardPage toggles Visible, which is why
// it can also skip rendering the hidden ones.
$Common = "../Common.ui";
$G = "GmCommon.ui";

$TabMatch = "GmTabMatch.ui";
$TabLog = "GmTabLog.ui";

$Common.@PageOverlay #MainPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;

    $Common.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 1240, Height: 768);

        #Title {
            $Common.@Title {
                @Text = %gg.ui.title;
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 12);

            // Tab strip. Button ids are "#TabButton<GmTab>"; the active one is disabled.
            Group #TabStrip {
                LayoutMode: Left;
                Anchor: (Height: 30, Bottom: 8);

                $G.@Tab #TabButtonMatch    { @Anchor = (Right: 4); Text: %gg.ui.tab.match; }
                $G.@Tab #TabButtonLog      { @Anchor = (Right: 4); Text: %gg.ui.tab.log; }

                Group { FlexWeight: 1; }
            }

            // Transient feedback line: set on every GM action so each click gives visible feedback.
            Group #StatusBar {
                LayoutMode: Left;
                Anchor: (Height: 26, Bottom: 8);
                Background: (Color: #000000(0.22));
                Padding: (Horizontal: 10);

                Label #ActionStatus {
                    FlexWeight: 1;
                    Text: %gg.ui.ready;
                    Style: (FontSize: 12, TextColor: #7a9cc6, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
                }
            }

            // Tab panels. Ids are "#Tab<GmTab>", matching GmTab.panelSelector().
            Group #TabBody {
                FlexWeight: 1;
                LayoutMode: Full;

                $TabMatch.@Content    #TabMatch    { Visible: true; }
                $TabLog.@Content      #TabLog      { Visible: false; }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Confirm prompt
//
// A sibling overlay rather than an in-place "click again" arm: stopping or resetting a live match
// throws every player out, and that is not something a mis-click should be able to do. The page
// hides #MainPage while this is up and remembers which action it is asking about.
// ---------------------------------------------------------------------------------------------

$Common.@PageOverlay #ConfirmPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;
    Visible: false;

    $Common.@DecoratedContainer {
        Anchor: (Width: 460);

        #Title {
            $Common.@Title {
                @Text = %gg.ui.confirm.title;
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 20);

            Label #ConfirmMessage {
                Anchor: (Bottom: 20);
                Style: (FontSize: 14, TextColor: #d6e4ee, Wrap: true, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: Left;
                Anchor: (Height: 30);

                $G.@Danger  #ConfirmYes { @Anchor = (Right: 4); Text: %gg.ui.confirm.yes; }
                $G.@Confirm #ConfirmNo  { @Anchor = (Left: 4);  Text: %gg.ui.confirm.no; }
            }
        }
    }
}
