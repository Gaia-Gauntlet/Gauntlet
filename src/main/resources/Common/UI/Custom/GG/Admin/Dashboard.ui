// Gaia Gauntlet admin dashboard: the shell only. The game picker, the tab strip, the status line,
// and one resident panel per tab. AdminPage toggles which panel is visible and renders it.
$Common = "../../Common.ui";
$G = "Common.ui";

$TabMatch = "TabMatch.ui";
$TabGames = "TabGames.ui";
$TabZones = "TabZones.ui";
$TabEvents = "TabEvents.ui";
$TabBosses = "TabBosses.ui";
$TabTeams = "TabTeams.ui";
$TabSettings = "TabSettings.ui";
$TabLog = "TabLog.ui";

$Common.@PageOverlay #MainPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;

    $Common.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 1240, Height: 768);

        #Title {
            $Common.@Title {
                @Text = "Gaia Gauntlet";
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 12);

            // Game picker and tab strip.
            Group #TopStrip {
                LayoutMode: Left;
                Anchor: (Height: 30, Bottom: 8);

                Label {
                    Text: "Game";
                    Anchor: (Width: 44);
                    Style: (FontSize: 12, RenderUppercase: true, TextColor: #878e9c, VerticalAlignment: Center, LetterSpacing: 1);
                }
                $G.@Picker #GamePicker { FlexWeight: 0; Anchor: (Width: 200, Right: 14); }

                $G.@Tab #TabMatch    { @Anchor = (Right: 4); Text: "Match"; }
                $G.@Tab #TabGames    { @Anchor = (Right: 4); Text: "Games"; }
                $G.@Tab #TabZones    { @Anchor = (Right: 4); Text: "Zones"; }
                $G.@Tab #TabEvents   { @Anchor = (Right: 4); Text: "Events"; }
                $G.@Tab #TabBosses   { @Anchor = (Right: 4); Text: "Bosses"; }
                $G.@Tab #TabTeams    { @Anchor = (Right: 4); Text: "Teams"; }
                $G.@Tab #TabSettings { @Anchor = (Right: 4); Text: "Settings"; }
                $G.@Tab #TabLog      { @Anchor = (Right: 4); Text: "Log"; }

                Group { FlexWeight: 1; }
            }

            // Feedback line, set on every action so each click answers.
            Group #StatusBar {
                LayoutMode: Left;
                Anchor: (Height: 26, Bottom: 8);
                Background: (Color: #000000(0.22));
                Padding: (Horizontal: 10);

                Label #ActionStatus {
                    FlexWeight: 1;
                    Text: "Ready";
                    Style: (FontSize: 12, TextColor: #7a9cc6, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
                }
            }

            Group #TabBody {
                FlexWeight: 1;
                LayoutMode: Full;

                $TabMatch.@Content    #PanelMatch    { Visible: true; }
                $TabGames.@Content    #PanelGames    { Visible: false; }
                $TabZones.@Content    #PanelZones    { Visible: false; }
                $TabEvents.@Content   #PanelEvents   { Visible: false; }
                $TabBosses.@Content   #PanelBosses   { Visible: false; }
                $TabTeams.@Content    #PanelTeams    { Visible: false; }
                $TabSettings.@Content #PanelSettings { Visible: false; }
                $TabLog.@Content      #PanelLog      { Visible: false; }
            }
        }
    }
}

// Confirm prompt for the actions that throw players out of a match or a game.
$Common.@PageOverlay #ConfirmPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;
    Visible: false;

    $Common.@DecoratedContainer {
        Anchor: (Width: 460);

        #Title {
            $Common.@Title {
                @Text = "Are you sure?";
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 20);

            Label #ConfirmMessage {
                Anchor: (Bottom: 20);
                Style: (FontSize: 14, TextColor: #d6e4ee, Wrap: true, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: Left;
                Anchor: (Height: 30);

                $G.@Danger  #ConfirmYes { @Anchor = (Right: 4); Text: "Yes, do it"; }
                $G.@Confirm #ConfirmNo  { @Anchor = (Left: 4);  Text: "No, go back"; }
            }
        }
    }
}
