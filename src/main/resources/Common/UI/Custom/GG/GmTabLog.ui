// GM dashboard - Log tab. One full-width column, because a log line is long and wrapping it into a
// third of the screen makes it unreadable.
$G = "GmCommon.ui";

@Content = Group {
    LayoutMode: Top;

    $G.@Card {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8);

        $G.@Field #LogMatchField { @Key = %gg.ui.field.state; FlexWeight: 1; }
        $G.@Field #LogClockField { @Key = %gg.ui.field.clock; FlexWeight: 1; }
    }

    $G.@Card {
        FlexWeight: 1;

        $G.@Header { @Text = %gg.ui.log; }
        Group #LogList {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $G.@ScrollbarStyle;
            Background: (Color: #000000(0.18));
            Padding: (Full: 6);
        }
    }
};
