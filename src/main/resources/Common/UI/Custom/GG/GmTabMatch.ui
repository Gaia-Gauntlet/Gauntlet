// GM dashboard - Match tab. Everything you reach for while players are fighting.
$G = "GmCommon.ui";

@Content = Group {
    LayoutMode: Left;

    // ===== Status and match control =============================================
    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = %gg.ui.status; }
            $G.@Field #StatusStateField  { @Key = %gg.ui.field.state; }
            $G.@Field #StatusFormatField { @Key = %gg.ui.field.format; }
            $G.@Field #StatusWinField    { @Key = %gg.ui.field.winCondition; }
            $G.@Field #StatusAliveField  { @Key = %gg.ui.field.players; }
            $G.@Field #StatusTeamsField  { @Key = %gg.ui.field.teams; }
            $G.@Field #StatusClockField  { @Key = %gg.ui.field.clock; }
        }

        $G.@Card {
            $G.@Header { @Text = %gg.ui.matchControl; }
            $G.@ButtonRow {
                $G.@Action #MatchPause  { @Anchor = (Right: 3); Text: %gg.ui.pauseMatch; }
                $G.@Action #MatchResume { @Anchor = (Left: 3);  Text: %gg.ui.resumeMatch; }
            }
            $G.@ButtonRow {
                $G.@Danger #MatchStop  { @Anchor = (Right: 3); Text: %gg.ui.stop; }
                $G.@Danger #MatchReset { @Anchor = (Left: 3);  Text: %gg.ui.reset; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = %gg.ui.scores; }
            $G.@ListPanel #ScoreList {}
        }
    }

    $G.@Gutter {}

    // ===== Zone closing and events =============================================
    $G.@Column {
        $G.@Card {
            // These fields report the active zone-closing sequence.
            $G.@Header { @Text = %gg.ui.ring; }
            $G.@Field #ClosingPhaseField { @Key = %gg.ui.field.phase; }
            $G.@Field #ClosingTimerField { @Key = %gg.ui.field.timer; }
            $G.@Field #ClosingSweepField { @Key = %gg.ui.field.radius; }
            $G.@Field #ClosingStateField { @Key = %gg.ui.field.ringMode; }
            $G.@Field #ClosingSpeedField { @Key = %gg.ui.field.speed; }

            $G.@ButtonRow {
                $G.@Action #ClosingPause  { @Anchor = (Right: 3);         Text: %gg.ui.pause; }
                $G.@Action #ClosingResume { @Anchor = (Left: 3, Right: 3); Text: %gg.ui.resume; }
                $G.@Action #ClosingNext   { @Anchor = (Left: 3);          Text: %gg.ui.nextPhase; }
            }
            $G.@ButtonRow {
                $G.@Action #ClosingSpeedHalf { @Anchor = (Right: 3);         Text: %gg.ui.speedHalf; }
                $G.@Action #ClosingSpeedOne  { @Anchor = (Left: 3, Right: 3); Text: %gg.ui.speedOne; }
                $G.@Action #ClosingSpeedTwo  { @Anchor = (Left: 3, Right: 3); Text: %gg.ui.speedTwo; }
                $G.@Action #ClosingDelay     { @Anchor = (Left: 3);          Text: %gg.ui.delay30; }
            }

            $G.@Field #ClosingOrderField { @Key = %gg.ui.field.closingOrder; }
            $G.@Field #ClosingNextField { @Key = %gg.ui.field.nextZone; }
            $G.@PickerRow {
                $G.@Picker #ClosingZonePicker { @Anchor = (Right: 4); }
                $G.@Go #ClosingNextZone { @Anchor = (Left: 4); Text: %gg.ui.closeNext; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = %gg.ui.events; }
            $G.@ListPanel #EventList {}
            $G.@ButtonRow {
                $G.@Action #EvtTriggerNext { Text: %gg.ui.triggerNext; }
            }
        }
    }

    $G.@Gutter {}

    // ===== Bosses and weather ===================================================
    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = %gg.ui.bosses; }
            $G.@ListPanel #BossList {}
            $G.@PickerRow {
                $G.@Picker #BossPicker { @Anchor = (Right: 4); }
                $G.@Go #BossSpawnSelected { @Anchor = (Left: 4); Text: %gg.ui.spawn; }
            }
            $G.@ButtonRow {
                $G.@Action #BossSpawnRandom { @Anchor = (Right: 3); Text: %gg.ui.spawnRandom; }
                $G.@Action #BossDespawnAll  { @Anchor = (Left: 3);  Text: %gg.ui.despawnAll; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = %gg.ui.players; }
            $G.@PickerRow {
                $G.@Picker #DeadPlayerPicker { @Anchor = (Right: 4); }
                $G.@Go #PlayerRevive { @Anchor = (Left: 4); Text: %gg.ui.revive; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = %gg.ui.weather; }
            $G.@Field #WeatherField { @Key = %gg.ui.field.active; }
            $G.@PickerRow {
                $G.@Picker #WeatherPicker { @Anchor = (Right: 4); }
                $G.@Go #WeatherStart { @Anchor = (Left: 4); Text: %gg.ui.start; }
            }
            $G.@ButtonRow {
                $G.@Action #WeatherRandom { @Anchor = (Right: 3); Text: %gg.ui.randomWeather; }
                $G.@Action #WeatherStop   { @Anchor = (Left: 3);  Text: %gg.ui.stopWeather; }
            }
        }
    }
};
