// One queued match event: its text and a cancel button.
$G = "../../Admin/Common.ui";

Group {
    LayoutMode: Left;
    Anchor: (Height: 26, Bottom: 3);

    Label #Text {
        FlexWeight: 1;
        Style: (FontSize: 12, TextColor: #c9d1d9, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
    }
    $G.@GoQuiet #Cancel { @Anchor = (Left: 6, Width: 70); Anchor: (Height: 24); Text: "Cancel"; }
}
