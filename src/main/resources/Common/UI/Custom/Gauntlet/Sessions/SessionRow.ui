// One session in the browser: its name and status, what it is playing, what is queued, how many
// are in it, and the join or leave button.
$G = "../Admin/Common.ui";

Group {
    LayoutMode: Left;
    Anchor: (Height: 66, Bottom: 6);
    Background: (Color: #000000(0.25));
    Padding: (Full: 8);

    Group {
        FlexWeight: 1;
        LayoutMode: Top;

        Group {
            Anchor: (Height: 22);
            LayoutMode: Left;

            Label #Name {
                FlexWeight: 1;
                Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
            }
            Label #State {
                Anchor: (Width: 160);
                Style: (FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #E8A93B, HorizontalAlignment: End, VerticalAlignment: Center, LetterSpacing: 1);
            }
        }
        Label #Now {
            Anchor: (Height: 16);
            Style: (FontSize: 12, TextColor: #c9d1d9, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
        }
        Label #Next {
            Anchor: (Height: 14);
            Style: (FontSize: 11, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
        }
    }

    Group {
        Anchor: (Width: 110, Left: 12);
        LayoutMode: Top;

        Label #Count {
            Anchor: (Height: 18, Bottom: 2);
            Style: (FontSize: 11, TextColor: #878e9c, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        $G.@Go #Action { @Anchor = (Left: 7); Text: "Join"; }
    }
}
