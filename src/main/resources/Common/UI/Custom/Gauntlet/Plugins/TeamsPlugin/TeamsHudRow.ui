// One team on the teams HUD: icon, its members' portraits with their scores, and the team score.
Group {
    Anchor: (Height: 48, Bottom: 6);
    LayoutMode: Left;
    Background: (Color: #0d1117(0.8));
    Padding: (Full: 4);

    Group #Icon {
        Anchor: (Width: 40, Height: 40);
        Background: (Color: #ffffff(0.08));

        Label #Initial {
            Style: (FontSize: 20, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
    }

    Group #Members {
        FlexWeight: 1;
        Anchor: (Left: 6);
        LayoutMode: Left;
    }

    Group {
        Anchor: (Width: 40);
        LayoutMode: Top;

        Label {
            Anchor: (Height: 14);
            Text: "SCORE";
            Style: (FontSize: 10, RenderBold: true, TextColor: #878e9c, HorizontalAlignment: Center);
        }
        Label #TeamScore {
            Anchor: (Height: 24);
            Text: "0";
            Style: (FontSize: 18, RenderBold: true, TextColor: #E8A93B, HorizontalAlignment: Center);
        }
    }
}
