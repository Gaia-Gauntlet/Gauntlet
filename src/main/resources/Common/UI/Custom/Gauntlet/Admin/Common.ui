// Building blocks shared by every tab of the Gaia Gauntlet admin dashboard.
// Buttons flex to an equal share of their row so long labels shrink instead of clipping.
$Common = "../../Common.ui";

// Containers

@Card = Group {
    LayoutMode: Top;
    Anchor: (Bottom: 8);
    Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 10);
};

@ScrollbarStyle = $Common.@DefaultScrollbarStyle;

// A scrolling column of cards. A tab is one, two, or three of these side by side.
@Column = Group {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: @ScrollbarStyle;
};

@Gutter = Group {
    Anchor: (Width: 6, Left: 6, Right: 6);
};

// Inset panel holding a generated list of rows.
@ListPanel = Group {
    LayoutMode: Top;
    Background: (Color: #000000(0.18));
    Padding: (Full: 6);
};

// A tall inset panel that scrolls, for logs and queues.
@ScrollPanel = Group {
    FlexWeight: 1;
    LayoutMode: TopScrolling;
    ScrollbarStyle: @ScrollbarStyle;
    Background: (Color: #000000(0.18));
    Padding: (Full: 6);
};

@ButtonRow = Group {
    LayoutMode: Left;
    Anchor: (Height: 30, Top: 4);
};

@PickerRow = Group {
    LayoutMode: Left;
    Anchor: (Height: 30, Top: 6);
};

// Text

@Header = Label {
    @Text = "";
    Style: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #E8A93B, LetterSpacing: 1);
    Anchor: (Height: 19, Bottom: 6);
    Text: @Text;
};

@Caption = Label {
    @Text = "";
    Style: (FontSize: 11, RenderUppercase: true, TextColor: #5a6a7a, LetterSpacing: 1);
    Anchor: (Height: 15, Top: 8);
    Text: @Text;
};

@Note = Label {
    @Text = "";
    Style: (FontSize: 12, TextColor: #878e9c, Wrap: true);
    Anchor: (Bottom: 4);
    Text: @Text;
};

// A key and value row. The value label is #Value so a page can set "#SomeField #Value.Text".
@Field = Group {
    @Key = "";
    LayoutMode: Left;
    Anchor: (Height: 20);

    Label {
        Text: @Key;
        Anchor: (Width: 116);
        Style: (FontSize: 12, TextColor: #878e9c, VerticalAlignment: Center);
    }
    Label #Value {
        FlexWeight: 1;
        Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
    }
};

// Buttons

@Action = TextButton {
    @Anchor = ();
    @Text = "";
    FlexWeight: 1;
    Style: $Common.@SmallTertiaryTextButtonStyle;
    Anchor: (...@Anchor, Height: 30);
    Padding: (Horizontal: 8);
    Text: @Text;
};

@Confirm = TextButton {
    @Anchor = ();
    @Text = "";
    FlexWeight: 1;
    Style: $Common.@SmallSecondaryTextButtonStyle;
    Anchor: (...@Anchor, Height: 30);
    Padding: (Horizontal: 8);
    Text: @Text;
};

@DangerStyle = TextButtonStyle(
    Default:  (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive.png", Border: 12),         LabelStyle: $Common.@SmallSecondaryButtonLabelStyle),
    Hovered:  (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive_Hovered.png", Border: 12), LabelStyle: $Common.@SmallSecondaryButtonLabelStyle),
    Pressed:  (Background: PatchStyle(TexturePath: "../../Common/Buttons/Destructive_Pressed.png", Border: 12), LabelStyle: $Common.@SmallSecondaryButtonLabelStyle),
    Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Disabled.png", Border: 12),            LabelStyle: $Common.@SmallButtonDisabledLabelStyle),
    Sounds: $Common.@ButtonsCancel
);

@Danger = TextButton {
    @Anchor = ();
    @Text = "";
    FlexWeight: 1;
    Style: @DangerStyle;
    Anchor: (...@Anchor, Height: 30);
    Padding: (Horizontal: 8);
    Text: @Text;
};

// The fixed width button beside a picker or an input; it must not flex so the input keeps the width.
@Go = TextButton {
    @Anchor = ();
    @Text = "";
    Style: $Common.@SmallSecondaryTextButtonStyle;
    Anchor: (...@Anchor, Width: 96, Height: 30);
    Padding: (Horizontal: 8);
    Text: @Text;
};

@GoQuiet = TextButton {
    @Anchor = ();
    @Text = "";
    Style: $Common.@SmallTertiaryTextButtonStyle;
    Anchor: (...@Anchor, Width: 96, Height: 30);
    Padding: (Horizontal: 8);
    Text: @Text;
};

// Tab button styles AdminPage switches between: a closed tab, the open tab, and a plugin the
// selected session does not have installed.
@TabStyle = $Common.@SmallTertiaryTextButtonStyle;
@TabActiveStyle = $Common.@SmallSecondaryTextButtonStyle;
@TabOffStyle = TextButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Tertiary.png", Border: 12),         LabelStyle: $Common.@SmallButtonDisabledLabelStyle),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Tertiary_Hovered.png", Border: 12), LabelStyle: $Common.@SmallButtonDisabledLabelStyle),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Tertiary_Pressed.png", Border: 12), LabelStyle: $Common.@SmallButtonDisabledLabelStyle),
    Sounds: $Common.@ButtonSounds
);

// One entry in a tab strip.
@Tab = TextButton {
    @Anchor = ();
    @Text = "";
    Style: @TabStyle;
    Anchor: (...@Anchor, Width: 104, Height: 30);
    Padding: (Horizontal: 6);
    Text: @Text;
};

// Inputs

@Picker = DropdownBox {
    @Anchor = ();
    FlexWeight: 1;
    Anchor: (...@Anchor, Height: 30);
    Style: (
        ...$Common.@DefaultDropdownBoxStyle,
        LabelStyle: (...$Common.@DefaultDropdownBoxLabelStyle, RenderUppercase: false, FontSize: 12),
        EntryLabelStyle: (...$Common.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 12),
        SelectedEntryLabelStyle: (...$Common.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 12, RenderBold: true),
        NoItemsLabelStyle: (...$Common.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false, FontSize: 12, TextColor: #b7cedd(0.5)),
        PanelAlign: Bottom,
        PanelWidth: 260
    );
};

@Input = TextField {
    @Anchor = ();
    @Placeholder = "";
    FlexWeight: 1;
    Style: (...$Common.@DefaultInputFieldStyle, FontSize: 12);
    PlaceholderStyle: (...$Common.@DefaultInputFieldPlaceholderStyle, FontSize: 12);
    Background: $Common.@InputBoxBackground;
    Anchor: (...@Anchor, Height: 30);
    Padding: (Horizontal: 8);
    PlaceholderText: @Placeholder;
};

@SmallInput = TextField {
    @Anchor = ();
    @Placeholder = "";
    Style: (...$Common.@DefaultInputFieldStyle, FontSize: 12);
    PlaceholderStyle: (...$Common.@DefaultInputFieldPlaceholderStyle, FontSize: 12);
    Background: $Common.@InputBoxBackground;
    Anchor: (...@Anchor, Width: 90, Height: 30);
    Padding: (Horizontal: 8);
    PlaceholderText: @Placeholder;
};
