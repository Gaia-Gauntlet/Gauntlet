// Games tab: hubs, games, and moving players into them.
$G = "Common.ui";

@Content = Group {
    LayoutMode: Left;

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Selected game"; }
            $G.@Field #GameStateField { @Key = "State"; }
            $G.@Field #GameHubField   { @Key = "Hub"; }
            $G.@ListPanel #LobbyList {}
            $G.@ButtonRow {
                $G.@Confirm #GameOpen  { @Anchor = (Right: 3); Text: "Open lobbies"; }
                $G.@Danger  #GameClose { @Anchor = (Left: 3); Text: "Close game"; }
            }
            $G.@ButtonRow {
                $G.@Danger #GameRemove { Text: "Remove game"; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = "New game"; }
            $G.@PickerRow {
                $G.@Picker #GameTypePicker { @Anchor = (Right: 6); }
                $G.@Go #GameCreate { Text: "Create"; }
            }
            $G.@Field #GameTypeField { @Key = "About"; }
            $G.@Note { @Text = "Created on the selected game's hub with the next free id, and opened right away."; }
        }
    }

    $G.@Gutter {}

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Send players in"; }
            $G.@ButtonRow {
                $G.@Confirm #GamePull    { @Anchor = (Right: 3); Text: "Pull the game's teams"; }
                $G.@Confirm #GameSendAll { @Anchor = (Left: 3); Text: "Send everyone in the hub"; }
            }
            $G.@Caption { @Text = "One player"; }
            $G.@PickerRow {
                $G.@Input #GameSendName { @Anchor = (Right: 6); @Placeholder = "username"; }
                $G.@Go #GameSendPlayer { Text: "Send"; }
            }
            $G.@Caption { @Text = "One team"; }
            $G.@PickerRow {
                $G.@Picker #GameSendTeam { @Anchor = (Right: 6); }
                $G.@Go #GameSendTeamGo { Text: "Send"; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = "Hubs"; }
            $G.@ListPanel #HubList {}
        }
    }
};
