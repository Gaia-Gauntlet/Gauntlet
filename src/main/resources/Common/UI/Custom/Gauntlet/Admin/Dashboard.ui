// Gaia Gauntlet admin dashboard: the shell only. The section strip, the status line, the session
// picker and tab strip of the open section, and one resident panel per tab. AdminPage toggles which
// panel is visible and renders it.
$Common = "../../Common.ui";
$G = "Common.ui";

//$TabMatch = "TabMatch.ui";
//$TabGames = "TabGames.ui";
//$TabZones = "TabZones.ui";
//$TabEvents = "TabEvents.ui";
//$TabBosses = "TabBosses.ui";
//$TabTeams = "TabTeams.ui";
//$TabSettings = "TabSettings.ui";
//$TabLog = "TabLog.ui";

$Common.@PageOverlay #MainPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;

    $Common.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 1240, Height: 768);

        #Title {
            $Common.@Title {
                @Text = "Gauntlet";
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 12);

            // Session, Controller, then one button per plugin section get dynamically added here
            Group #SectionStrip {
                LayoutMode: Left;
                Anchor: (Height: 30, Bottom: 8);
            }

            // Feedback line, set on every action so each click answers.
            Group #StatusBar {
                LayoutMode: Left;
                Anchor: (Height: 26, Bottom: 8);
                Background: (Color: #000000(0.22));
                Padding: (Horizontal: 10);

                Label #ActionStatus {
                    FlexWeight: 1;
                    Text: "Not Ready";
                    Style: (FontSize: 12, TextColor: #7a9cc6, VerticalAlignment: Center, Wrap: true, WrapMaxLines: 1);
                }
            }

            Group #SubRow {
                LayoutMode: Left;
                Anchor: (Height: 30, Bottom: 8);

                Group #SessionRow {
                    LayoutMode: Left;
                    Anchor: (Width: 230);

                    Label {
                        Text: "Session";
                        Anchor: (Width: 66);
                        Style: (FontSize: 12, RenderUppercase: true, TextColor: #878e9c, VerticalAlignment: Center, LetterSpacing: 1);
                    }
                    $G.@Picker #SessionPicker { FlexWeight: 0; Anchor: (Width: 150, Right: 14); }
                }

                // Tab buttons of every section get dynamically added here
                Group #SubStrip { LayoutMode: Left; }

                Group { FlexWeight: 1; }
            }

            Group #PluginBar {
                LayoutMode: Left;
                Anchor: (Height: 30, Bottom: 8);
                Visible: false;

                $G.@Danger #UninstallPlugin { FlexWeight: 0; @Anchor = (Width: 150); Text: "Uninstall Plugin"; }
            }

            Group {
                FlexWeight: 1;
                LayoutMode: Full;

                Group #TabBody {
                    LayoutMode: Full;

                    // Panels get dynamically added here

                }

                // Shown when the open section has nothing to show, offering to install its plugin.
                Group #Notice {
                    LayoutMode: Middle;
                    Visible: false;

                    Group {
                        LayoutMode: Top;
                        Anchor: (Width: 360);

                        Label #NoticeText {
                            Anchor: (Bottom: 12);
                            Style: (FontSize: 14, TextColor: #d6e4ee, Wrap: true, HorizontalAlignment: Center);
                        }
                        $G.@ButtonRow #InstallPlugin {
                            $G.@Confirm #InstallPluginButton { Text: "Install Plugin"; }
                        }
                    }
                }
            }
        }
    }
}

// Confirm prompt for the actions that throw players out of a match or a game.
$Common.@PageOverlay #ConfirmPage {
    Anchor: (Full: 0);
    LayoutMode: Middle;
    Visible: false;

    $Common.@DecoratedContainer {
        Anchor: (Width: 460);

        #Title {
            $Common.@Title {
                @Text = "Are you sure?";
            }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 20);

            Label #ConfirmMessage {
                Anchor: (Bottom: 20);
                Style: (FontSize: 14, TextColor: #d6e4ee, Wrap: true, HorizontalAlignment: Center);
            }

            Group {
                LayoutMode: Left;
                Anchor: (Height: 30);

                $G.@Danger  #ConfirmYes { @Anchor = (Right: 4); Text: "Yes, do it"; }
                $G.@Confirm #ConfirmNo  { @Anchor = (Left: 4);  Text: "No, go back"; }
            }
        }
    }
}
