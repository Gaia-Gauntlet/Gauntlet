// Match tab: where the game is, the timer, the life cycle actions, and preflight.
$G = "Common.ui";

@Content = Group {
    LayoutMode: Left;

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Status"; }
            $G.@Field #GameField    { @Key = "Game"; }
            $G.@Field #StateField   { @Key = "State"; }
            $G.@Field #HubField     { @Key = "Hub"; }
            $G.@Field #LobbiesField { @Key = "Lobbies"; }
            $G.@Field #ArenaField   { @Key = "Arena"; }
            $G.@Field #PortalField  { @Key = "Portal"; }
            $G.@Field #TimerField   { @Key = "Timer"; }
            $G.@Field #AliveField   { @Key = "Alive"; }
        }

        $G.@Card {
            $G.@Header { @Text = "Countdown"; }
            $G.@ButtonRow {
                $G.@Action #TimerSkip   { @Anchor = (Right: 3); Text: "Skip"; }
                $G.@Action #TimerPause  { @Anchor = (Left: 3, Right: 3); Text: "Pause"; }
                $G.@Action #TimerResume { @Anchor = (Left: 3); Text: "Resume"; }
            }
            $G.@PickerRow {
                $G.@Input #TimerSeconds { @Anchor = (Right: 6); @Placeholder = "seconds"; }
                $G.@Go #TimerSet { Text: "Set timer"; }
            }
        }
    }

    $G.@Gutter {}

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Lobby"; }
            $G.@ButtonRow {
                $G.@Confirm #MatchStart    { @Anchor = (Right: 3); Text: "Start countdown"; }
                $G.@Confirm #MatchPortal   { @Anchor = (Left: 3); Text: "Open portal"; }
            }
            $G.@ButtonRow {
                $G.@Confirm #MatchTransfer { Text: "Transfer everyone to the arena"; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = "Arena"; }
            $G.@ButtonRow {
                $G.@Action #MatchSuddenDeath { @Anchor = (Right: 3); Text: "Sudden death"; }
                $G.@Action #MatchEnd         { @Anchor = (Left: 3); Text: "End match"; }
            }
            $G.@ButtonRow {
                $G.@Danger #MatchStop { Text: "Stop and return everyone to the lobby"; }
            }
        }

        $G.@Card {
            $G.@Header { @Text = "Event"; }
            $G.@Note { @Text = "Every match adds its points to each team's event score, shown in the lobby."; }
            $G.@ButtonRow {
                $G.@Danger #ResetScores { Text: "Reset event scores"; }
            }
        }
    }

    $G.@Gutter {}

    $G.@Column {
        $G.@Card {
            FlexWeight: 1;
            $G.@Header { @Text = "Preflight"; }
            $G.@ScrollPanel #PreflightList {}
        }
    }
};
