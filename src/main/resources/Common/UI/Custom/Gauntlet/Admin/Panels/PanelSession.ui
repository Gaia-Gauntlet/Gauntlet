// Session tab: the selected session's status, creating and destroying sessions, its game life cycle
// and queue, its installed plugins, and the parties in it.
$G = "../../Admin/Common.ui";

Group {
    LayoutMode: Left;
    Visible: false;

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Status"; }
            $G.@Field #SessionField { @Key = "Session"; }
            $G.@Field #GameField    { @Key = "Game"; }
            $G.@Field #StateField   { @Key = "State"; }
            $G.@Field #ErrorField   { @Key = "Error"; }
            $G.@Field #PlayersField { @Key = "Players online"; }
        }

        $G.@Card {
            $G.@Header { @Text = "New session"; }
            $G.@PickerRow {
                $G.@Input #NewSessionId { @Anchor = (Right: 6); @Placeholder = "session id"; }
                $G.@Go #CreateSession { Text: "Create"; }
            }
            $G.@Note { @Text = "Starts empty. Add games to its queue, then set up the first one."; }
        }

        $G.@Card {
            $G.@Header { @Text = "Session"; }
            $G.@ButtonRow {
                $G.@Danger #DestroySession { Text: "Destroy session"; }
            }
        }
    }

    $G.@Gutter {}

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Game"; }
            $G.@ButtonRow {
                $G.@Confirm #SetupGame { @Anchor = (Right: 3); Text: "Set up next game"; }
                $G.@Danger #StopGame { @Anchor = (Left: 3); Text: "Stop game"; }
            }
            $G.@Note { @Text = "Setting up takes the first game off the queue and runs it. The Match tab runs the match itself."; }
        }

        $G.@Card {
            $G.@Header { @Text = "Queue"; }
            $G.@ListPanel #GameList {}
            $G.@PickerRow {
                $G.@Picker #GamePicker { @Anchor = (Right: 6); }
                $G.@Go #AddGame { Text: "Add"; }
            }
            $G.@ButtonRow {
                $G.@Action #PlayNext   { @Anchor = (Right: 3); Text: "Play it next"; }
                $G.@Action #RemoveGame { @Anchor = (Left: 3); Text: "Remove it"; }
            }
        }
    }

    $G.@Gutter {}

    $G.@Column {
        $G.@Card {
            $G.@Header { @Text = "Plugins"; }
            $G.@ListPanel #PluginList {}
            $G.@PickerRow {
                $G.@Picker #PluginPicker { @Anchor = (Right: 6); }
                $G.@Go #AddPlugin { Text: "Install"; }
            }
            $G.@ButtonRow {
                $G.@Danger #RemovePlugin { Text: "Uninstall it"; }
            }
            $G.@Note { @Text = "Only installed plugins run. Queuing a game installs the plugins it uses."; }
        }

        $G.@Card {
            FlexWeight: 1;
            $G.@Header { @Text = "Parties"; }
            $G.@ScrollPanel #PartyList {}
        }
    }
}
