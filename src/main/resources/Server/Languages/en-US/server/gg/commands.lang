error= <color is="#f70000"><b>{message}</b></color>
session.create.success=<color is="#f7d600">Session {sessionId} added!</color>
session.list.line= <color is="#a2a2a2">{sessionId}</color> - <color is="#f7d600"><b>{game}</b></color> - {state}\
                    \n<i>{gamesList}</i>
session.add.success=<color is="#f7d600">Successfully added game {gameId} to {sessionId}</color>
session.remove.success=<color is="#f7d600">{status} removed game {gameId} from {sessionId}</color>
session.destroy.success=<color is="#f7d600">Removed {sessionId} from registry</color>

session.setup.pending=<color is="#f7d600">Setting up {sessionId}</color>
session.setup.success=<color is="#4af700">Setup {gameId} in {sessionId}</color>

session.start.pending=<color is="#f7d600">Starting {sessionId}</color>
session.start.success=<color is="#4af700">Started {gameId} in {sessionId}</color>

session.stop.pending=<color is="#f7d600">Stopping {sessionId}</color>
session.stop.success=<color is="#4af700">Stopped {gameId} in {sessionId}</color>


