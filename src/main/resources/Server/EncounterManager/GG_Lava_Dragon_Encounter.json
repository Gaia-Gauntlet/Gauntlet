{
  "$Comment": "Optional presentation controller. Combat is owned by the single JSON Lava Dragon role.",
  "Class": "EncounterManager",
  "Type": "Generic",
  "Debug": "DisplayState,DisplayTarget",
  "StartState": "Intro",
  "Instructions": [
    {
      "Sensor": { "Type": "Player", "Range": 45, "Collector": { "Type": "EncounterMembers" } },
      "Instructions": [
        {
          "Sensor": { "Type": "State", "State": "Intro" },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Mob", "Range": 70, "LockOnTarget": true, "LockedTargetSlot": "Boss", "Rebind": true, "Filters": [ { "Type": "NPCGroup", "IncludeGroups": [ "GG_Lava_Dragon_Boss" ] } ] },
              "Actions": [ { "Type": "Nothing" } ]
            },
            {
              "Sensor": { "Type": "Target", "Range": 100, "TargetSlot": "Boss" },
              "Actions": [
                { "Type": "StartEncounterMusic", "MusicContainer": "Track_Encounter_Cave_Test" },
                { "Type": "State", "State": "Active" }
              ]
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "Active" },
          "Instructions": [
            {
              "Sensor": { "Type": "Target", "Range": 100, "TargetSlot": "Boss" },
              "Actions": [ { "Type": "Nothing" } ]
            },
            {
              "Actions": [
                { "Type": "ReleaseTarget", "TargetSlot": "Boss" },
                { "Type": "StopEncounterMusic" },
                { "Type": "State", "State": "BossDead" }
              ]
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "BossDead" },
          "Instructions": [
            {
              "Actions": [
                { "Type": "SignalWorldEvent", "SignalId": "gg_lava_dragon_defeated" },
                { "Type": "State", "State": "Complete" }
              ]
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "Complete" },
          "Instructions": [
            {
              "Sensor": { "Type": "Beacon", "Message": "GG_Restart_Encounter" },
              "Actions": [ { "Type": "State", "State": "Intro" } ]
            }
          ]
        }
      ]
    }
  ]
}
